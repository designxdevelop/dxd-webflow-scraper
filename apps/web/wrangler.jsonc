{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "dxd-archiver-web",
  "account_id": "443d20e37c03fd9af4ee799444a4569e",
  "compatibility_date": "2026-10-01",
  // Static SPA: build with VITE_API_URL=https://zip-api.designxdevelop.com (see `bun run deploy`).
  "assets": { "directory": "./dist", "not_found_handling": "single-page-application" },
  // Rollback: remove the route (traffic falls back to the Railway origin behind the proxied DNS record).
  "routes": [{ "pattern": "zip.designxdevelop.com/*", "zone_name": "designxdevelop.com" }]
}
